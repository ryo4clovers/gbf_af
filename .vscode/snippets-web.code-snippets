{
  "[Web] HTML5 Document": {
    "scope": "html",
    "prefix": "/html5",
    "body": [
      "<!doctype html>",
      "<html lang=\"${1:ja}\">",
      "<head>",
      "  <meta charset=\"UTF-8\" />",
      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "  <title>${2:Document}</title>",
      "</head>",
      "<body>",
      "  ${0}",
      "</body>",
      "</html>"
    ],
    "description": "HTML5 document template"
  },
  "[Web] Head Meta Basic": {
    "scope": "html",
    "prefix": "/meta",
    "body": [
      "<meta charset=\"UTF-8\" />",
      "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "<meta name=\"description\" content=\"${1:description}\" />"
    ],
    "description": "Basic meta tags"
  },
  "[Web] Link CSS": {
    "scope": "html",
    "prefix": "/linkcss",
    "body": [
      "<link rel=\"stylesheet\" href=\"${1:styles.css}\" />"
    ],
    "description": "Link stylesheet"
  },
  "[Web] Script Module": {
    "scope": "html",
    "prefix": "/script",
    "body": [
      "<script type=\"module\" src=\"${1:main.js}\"></script>"
    ],
    "description": "Module script tag"
  },
  "[Web] Semantic Layout": {
    "scope": "html",
    "prefix": "/layout",
    "body": [
      "<header>",
      "  ${1}",
      "</header>",
      "",
      "<main>",
      "  ${0}",
      "</main>",
      "",
      "<footer>",
      "  ${2}",
      "</footer>"
    ],
    "description": "Semantic page layout"
  },
  "[Web] Section": {
    "scope": "html",
    "prefix": "/section",
    "body": [
      "<section aria-labelledby=\"${1:section-title}\">",
      "  <h2 id=\"${1:section-title}\">${2:Section title}</h2>",
      "  ${0}",
      "</section>"
    ],
    "description": "Accessible section with heading"
  },
  "[Web] Article": {
    "scope": "html",
    "prefix": "/article",
    "body": [
      "<article>",
      "  <h2>${1:Article title}</h2>",
      "  ${0}",
      "</article>"
    ],
    "description": "Article element"
  },
  "[Web] Nav": {
    "scope": "html",
    "prefix": "/nav",
    "body": [
      "<nav aria-label=\"${1:Primary}\">",
      "  <ul>",
      "    <li><a href=\"${2:#}\">${3:Link}</a></li>",
      "  </ul>",
      "</nav>"
    ],
    "description": "Accessible navigation"
  },
  "[Web] Anchor": {
    "scope": "html",
    "prefix": "/a",
    "body": [
      "<a href=\"${1:#}\">${2:link text}</a>"
    ],
    "description": "Anchor link"
  },
  "[Web] External Link": {
    "scope": "html",
    "prefix": "/aext",
    "body": [
      "<a href=\"${1:https://example.com}\" target=\"_blank\" rel=\"noopener noreferrer\">${2:link text}</a>"
    ],
    "description": "External link with security attributes"
  },
  "[Web] Image": {
    "scope": "html",
    "prefix": "/img",
    "body": [
      "<img src=\"${1:image.png}\" alt=\"${2:説明テキスト}\" width=\"${3:640}\" height=\"${4:360}\" />"
    ],
    "description": "Image with alt text and dimensions"
  },
  "[Web] Picture": {
    "scope": "html",
    "prefix": "/picture",
    "body": [
      "<picture>",
      "  <source srcset=\"${1:image.webp}\" type=\"image/webp\" />",
      "  <img src=\"${2:image.png}\" alt=\"${3:説明テキスト}\" width=\"${4:640}\" height=\"${5:360}\" />",
      "</picture>"
    ],
    "description": "Picture element with fallback image"
  },
  "[Web] Button": {
    "scope": "html",
    "prefix": "/button",
    "body": [
      "<button type=\"${1:button}\">${2:Button}</button>"
    ],
    "description": "Button element with explicit type"
  },
  "[Web] Form": {
    "scope": "html",
    "prefix": "/form",
    "body": [
      "<form action=\"${1:#}\" method=\"${2:post}\">",
      "  <div>",
      "    <label for=\"${3:name}\">${4:Name}</label>",
      "    <input id=\"${3:name}\" name=\"${3:name}\" type=\"${5:text}\" />",
      "  </div>",
      "",
      "  <button type=\"submit\">${6:Submit}</button>",
      "</form>"
    ],
    "description": "Basic accessible form"
  },
  "[Web] Input Field": {
    "scope": "html",
    "prefix": "/input",
    "body": [
      "<label for=\"${1:field}\">${2:Label}</label>",
      "<input id=\"${1:field}\" name=\"${1:field}\" type=\"${3:text}\" />"
    ],
    "description": "Input with label"
  },
  "[Web] Textarea Field": {
    "scope": "html",
    "prefix": "/textarea",
    "body": [
      "<label for=\"${1:message}\">${2:Message}</label>",
      "<textarea id=\"${1:message}\" name=\"${1:message}\" rows=\"${3:5}\"></textarea>"
    ],
    "description": "Textarea with label"
  },
  "[Web] Select Field": {
    "scope": "html",
    "prefix": "/select",
    "body": [
      "<label for=\"${1:option}\">${2:Option}</label>",
      "<select id=\"${1:option}\" name=\"${1:option}\">",
      "  <option value=\"${3:value}\">${4:Label}</option>",
      "</select>"
    ],
    "description": "Select with label"
  },
  "[Web] Table": {
    "scope": "html",
    "prefix": "/table",
    "body": [
      "<table>",
      "  <caption>${1:Table caption}</caption>",
      "  <thead>",
      "    <tr>",
      "      <th scope=\"col\">${2:Header}</th>",
      "    </tr>",
      "  </thead>",
      "  <tbody>",
      "    <tr>",
      "      <td>${0:Cell}</td>",
      "    </tr>",
      "  </tbody>",
      "</table>"
    ],
    "description": "Accessible table"
  },
  "[Web] Details": {
    "scope": "html",
    "prefix": "/details",
    "body": [
      "<details>",
      "  <summary>${1:Summary}</summary>",
      "  ${0}",
      "</details>"
    ],
    "description": "Details disclosure element"
  },
  "[Web] Dialog": {
    "scope": "html",
    "prefix": "/dialog",
    "body": [
      "<dialog id=\"${1:dialog}\">",
      "  <form method=\"dialog\">",
      "    <p>${2:Dialog content}</p>",
      "    <button type=\"submit\">${3:Close}</button>",
      "  </form>",
      "</dialog>"
    ],
    "description": "Native dialog element"
  },
  "[Web] CSS Reset Minimal": {
    "scope": "css",
    "prefix": "/reset",
    "body": [
      "*,",
      "*::before,",
      "*::after {",
      "  box-sizing: border-box;",
      "}",
      "",
      "body {",
      "  margin: 0;",
      "  min-height: 100vh;",
      "}"
    ],
    "description": "Minimal CSS reset"
  },
  "[Web] CSS Variables": {
    "scope": "css",
    "prefix": "/vars",
    "body": [
      ":root {",
      "  --color-text: ${1:#111827};",
      "  --color-background: ${2:#ffffff};",
      "  --space-md: ${3:1rem};",
      "}"
    ],
    "description": "CSS custom properties"
  },
  "[Web] Media Query": {
    "scope": "css",
    "prefix": "/media",
    "body": [
      "@media (min-width: ${1:768px}) {",
      "  ${0}",
      "}"
    ],
    "description": "CSS media query"
  },
  "[Web] Flex Center": {
    "scope": "css",
    "prefix": "/flexcenter",
    "body": [
      "display: flex;",
      "align-items: center;",
      "justify-content: center;"
    ],
    "description": "Flex center alignment"
  },
  "[Web] Grid Layout": {
    "scope": "css",
    "prefix": "/grid",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(${1:auto-fit}, minmax(${2:240px}, 1fr));",
      "gap: ${3:1rem};"
    ],
    "description": "Responsive CSS grid"
  },
  "[Web] Visually Hidden": {
    "scope": "css",
    "prefix": "/sr-only",
    "body": [
      ".sr-only {",
      "  position: absolute;",
      "  width: 1px;",
      "  height: 1px;",
      "  padding: 0;",
      "  margin: -1px;",
      "  overflow: hidden;",
      "  clip: rect(0, 0, 0, 0);",
      "  white-space: nowrap;",
      "  border: 0;",
      "}"
    ],
    "description": "Visually hidden utility class"
  },
  "[Web] Focus Visible": {
    "scope": "css",
    "prefix": "/focus",
    "body": [
      ":focus-visible {",
      "  outline: ${1:2px} solid ${2:currentColor};",
      "  outline-offset: ${3:2px};",
      "}"
    ],
    "description": "Accessible focus-visible style"
  },
  "[Web] Container": {
    "scope": "css",
    "prefix": "/container",
    "body": [
      ".${1:container} {",
      "  width: min(100% - ${2:2rem}, ${3:1120px});",
      "  margin-inline: auto;",
      "}"
    ],
    "description": "Responsive container utility"
  },
  "[Web] Card": {
    "scope": "html,css",
    "prefix": "/card",
    "body": [
      "<article class=\"${1:card}\">",
      "  <h2>${2:Card title}</h2>",
      "  <p>${0:Card content}</p>",
      "</article>"
    ],
    "description": "Simple card markup"
  },
  "[Web] ARIA Live Region": {
    "scope": "html",
    "prefix": "/live",
    "body": [
      "<div role=\"status\" aria-live=\"polite\">",
      "  ${0}",
      "</div>"
    ],
    "description": "ARIA live region"
  }
}
