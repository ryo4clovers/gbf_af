{
  "[Rust] Module Doc Comment": {
    "scope": "rust",
    "prefix": "/moddoc",
    "body": [
      "//! # ${1:module_name}",
      "//!",
      "//! ${2:モジュールの概要}.",
      "//!",
      "//! ## Notes",
      "//!",
      "//! ${3:補足事項}",
    ],
    "description": "Rust module-level documentation comment",
  },
  "[Rust] Doc Comment": {
    "scope": "rust",
    "prefix": "/doc",
    "body": [
      "/// ${1:概要}.",
      "///",
      "/// # Arguments",
      "///",
      "/// * `${2:arg}` - ${3:引数の説明}",
      "///",
      "/// # Returns",
      "///",
      "/// ${4:戻り値の説明}",
      "///",
      "/// # Errors",
      "///",
      "/// ${5:エラー条件}",
    ],
    "description": "Rust documentation comment",
  },
  "[Rust] Simple Doc Comment": {
    "scope": "rust",
    "prefix": "/docs",
    "body": ["/// ${1:概要}."],
    "description": "Simple Rust documentation comment",
  },
  "[Rust] Function": {
    "scope": "rust",
    "prefix": "/fn",
    "body": [
      "fn ${1:function_name}(${2:args}) -> ${3:return_type} {",
      "    ${0:todo!()}",
      "}",
    ],
    "description": "Rust function",
  },
  "[Rust] Public Function": {
    "scope": "rust",
    "prefix": "/pubfn",
    "body": [
      "pub fn ${1:function_name}(${2:args}) -> ${3:return_type} {",
      "    ${0:todo!()}",
      "}",
    ],
    "description": "Rust public function",
  },
  "[Rust] Result Function": {
    "scope": "rust",
    "prefix": "/resultfn",
    "body": [
      "fn ${1:function_name}(${2:args}) -> Result<${3:()}, ${4:Box<dyn std::error::Error>}> {",
      "    ${0:Ok(())}",
      "}",
    ],
    "description": "Rust function returning Result",
  },
  "[Rust] Main Result": {
    "scope": "rust",
    "prefix": "/main",
    "body": [
      "fn main() -> Result<(), Box<dyn std::error::Error>> {",
      "    ${0:Ok(())}",
      "}",
    ],
    "description": "Rust main function returning Result",
  },
  "[Rust] Struct": {
    "scope": "rust",
    "prefix": "/struct",
    "body": [
      "#[derive(Debug, Clone)]",
      "struct ${1:StructName} {",
      "    ${2:field}: ${3:String},",
      "}",
    ],
    "description": "Rust struct",
  },
  "[Rust] Public Struct": {
    "scope": "rust",
    "prefix": "/pubstruct",
    "body": [
      "#[derive(Debug, Clone)]",
      "pub struct ${1:StructName} {",
      "    pub ${2:field}: ${3:String},",
      "}",
    ],
    "description": "Rust public struct",
  },
  "[Rust] Enum": {
    "scope": "rust",
    "prefix": "/enum",
    "body": [
      "#[derive(Debug, Clone, PartialEq, Eq)]",
      "enum ${1:EnumName} {",
      "    ${2:Variant},",
      "}",
    ],
    "description": "Rust enum",
  },
  "[Rust] Impl": {
    "scope": "rust",
    "prefix": "/impl",
    "body": [
      "impl ${1:TypeName} {",
      "    pub fn new(${2:args}) -> Self {",
      "        Self {",
      "            ${0:field},",
      "        }",
      "    }",
      "}",
    ],
    "description": "Rust impl block with constructor",
  },
  "[Rust] Trait": {
    "scope": "rust",
    "prefix": "/trait",
    "body": [
      "trait ${1:TraitName} {",
      "    fn ${2:method_name}(&self) -> ${3:return_type};",
      "}",
    ],
    "description": "Rust trait",
  },
  "[Rust] Impl Trait": {
    "scope": "rust",
    "prefix": "/impltrait",
    "body": [
      "impl ${1:TraitName} for ${2:TypeName} {",
      "    fn ${3:method_name}(&self) -> ${4:return_type} {",
      "        ${0:todo!()}",
      "    }",
      "}",
    ],
    "description": "Rust trait implementation",
  },
  "[Rust] Derive": {
    "scope": "rust",
    "prefix": "/derive",
    "body": ["#[derive(Debug, Clone, PartialEq, Eq)]"],
    "description": "Common Rust derive attributes",
  },
  "[Rust] Test Module": {
    "scope": "rust",
    "prefix": "/tests",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "    use super::*;",
      "",
      "    #[test]",
      "    fn ${1:test_name}() {",
      "        ${0:assert_eq!(actual, expected);}",
      "    }",
      "}",
    ],
    "description": "Rust test module",
  },
  "[Rust] Test Function": {
    "scope": "rust",
    "prefix": "/test",
    "body": [
      "#[test]",
      "fn ${1:test_name}() {",
      "    ${0:assert_eq!(actual, expected);}",
      "}",
    ],
    "description": "Rust test function",
  },
  "[Rust] Match": {
    "scope": "rust",
    "prefix": "/match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => ${3:expression},",
      "    _ => ${0:todo!()},",
      "}",
    ],
    "description": "Rust match expression",
  },
  "[Rust] If Let Some": {
    "scope": "rust",
    "prefix": "/ifsome",
    "body": ["if let Some(${1:value}) = ${2:option} {", "    ${0:}", "}"],
    "description": "Rust if let Some",
  },
  "[Rust] While Let Some": {
    "scope": "rust",
    "prefix": "/whilesome",
    "body": [
      "while let Some(${1:value}) = ${2:iter}.next() {",
      "    ${0:}",
      "}",
    ],
    "description": "Rust while let Some",
  },
  "[Rust] Vec": {
    "scope": "rust",
    "prefix": "/vec",
    "body": ["let ${1:values}: Vec<${2:Type}> = vec![${0}];"],
    "description": "Rust Vec initialization",
  },
  "[Rust] HashMap": {
    "scope": "rust",
    "prefix": "/hashmap",
    "body": [
      "use std::collections::HashMap;",
      "",
      "let mut ${1:map}: HashMap<${2:Key}, ${3:Value}> = HashMap::new();",
    ],
    "description": "Rust HashMap initialization",
  },
  "[Rust] Module Declaration": {
    "scope": "rust",
    "prefix": "/mod",
    "body": ["mod ${1:module_name};"],
    "description": "Rust module declaration",
  },
  "[Rust] Public Module Declaration": {
    "scope": "rust",
    "prefix": "/pubmod",
    "body": ["pub mod ${1:module_name};"],
    "description": "Rust public module declaration",
  },
  "[Rust] Allow Dead Code": {
    "scope": "rust",
    "prefix": "/allowdead",
    "body": ["#[allow(dead_code)]"],
    "description": "Allow dead code attribute",
  },
  "[Rust] Clippy Allow": {
    "scope": "rust",
    "prefix": "/allowclippy",
    "body": ["#[allow(clippy::${1:lint_name})]"],
    "description": "Allow specific Clippy lint",
  },
}
