{
  "[Python]Google Docstring": {
    "scope": "python",
    "prefix": "/doc",
    "body": [
      "\"\"\"${1:概要}.",
      "",
      "${2:詳細説明}",
      "",
      "Args:",
      "    ${3:arg1} (${4:type}): ${5:引数の説明}.",
      "    ${6:arg2} (${7:type}): ${8:引数の説明}.",
      "",
      "Returns:",
      "    ${9:return_type}: ${10:戻り値の説明}.",
      "",
      "Raises:",
      "    ${11:Exception}: ${12:例外条件の説明}.",
      "\"\"\"",
    ],
    "description": "Google style docstring",
  },
  "[Python]簡易 Google Docstring": {
    "scope": "python",
    "prefix": "/docf",
    "body": ["\"\"\"${1:概要}.\"\"\""],
    "description": "Simple Google style docstring",
  },
  "[Python]クラス Docstring": {
    "scope": "python",
    "prefix": "/docclass",
    "body": [
      "\"\"\"${1:クラス概要}.",
      "",
      "Attributes:",
      "    ${2:name} (${3:type}): ${4:属性の説明}.",
      "\"\"\"",
    ],
    "description": "Google style class docstring",
  },
  "[Python]メイン関数": {
    "scope": "python",
    "prefix": "/main",
    "body": [
      "def main() -> None:",
      "    \"\"\"Application entry point.\"\"\"",
      "",
      "    ${1:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()",
    ],
    "description": "Python main entry point",
  },
  "[Python]ロガー定義": {
    "scope": "python",
    "prefix": "/logger",
    "body": ["import logging", "", "logger = logging.getLogger(__name__)"],
    "description": "Logger definition",
  },
  "[Python]dataclass": {
    "scope": "python",
    "prefix": "/dataclass",
    "body": [
      "from dataclasses import dataclass",
      "",
      "@dataclass(slots=True)",
      "class ${1:ClassName}:",
      "    \"\"\"${2:概要}.\"\"\"",
      "",
      "    ${3:name}: ${4:str}",
    ],
    "description": "Dataclass template",
  },
  "[Python]typing import": {
    "scope": "python",
    "prefix": "/typing",
    "body": ["from typing import Final, Literal"],
    "description": "Typing imports",
  },
}
