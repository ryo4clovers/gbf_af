{
  "[Markdown]見出し1": {
    "scope": "markdown",
    "prefix": "/h1",
    "body": ["# ${1:Title(タイトル)}"],
    "description": "Markdown 見出し1を挿入",
  },
  "[Markdown]見出し2": {
    "scope": "markdown",
    "prefix": "/h2",
    "body": ["## ${1:Title(タイトル)}"],
    "description": "Markdown 見出し2を挿入",
  },
  "[Markdown]見出し3": {
    "scope": "markdown",
    "prefix": "/h3",
    "body": ["### ${1:Title(タイトル)}"],
    "description": "Markdown 見出し3を挿入",
  },
  "[Markdown]コードブロック": {
    "scope": "markdown",
    "prefix": "/code",
    "body": [
      "```${1|text,bash,zsh,json,yaml,toml,ini,markdown,python,typescript,javascript,go,rust,java,c,cpp,sql,diff,mermaid|}",
      "${2:code}",
      "```",
    ],
    "description": "Markdown コードブロックを挿入",
  },
  "[Markdown]インラインコード": {
    "scope": "markdown",
    "prefix": "/icode",
    "body": ["`${1:code}`"],
    "description": "Markdown インラインコードを挿入",
  },
  "[Markdown]引用": {
    "scope": "markdown",
    "prefix": "/quote",
    "body": ["> ${1:text}"],
    "description": "Markdown 引用を挿入",
  },
  "[Markdown]リンク": {
    "scope": "markdown",
    "prefix": "/link",
    "body": ["[${1:label}](${2:https://example.com})"],
    "description": "Markdown リンクを挿入",
  },
  "[Markdown]画像": {
    "scope": "markdown",
    "prefix": "/img",
    "body": ["![${1:alt}](${2:path/to/image.png})"],
    "description": "Markdown 画像を挿入",
  },
  "[Markdown]水平線": {
    "scope": "markdown",
    "prefix": "/hr",
    "body": ["---"],
    "description": "Markdown 水平線を挿入",
  },

  "[Markdown]メタデータ": {
    "scope": "markdown",
    "prefix": "/metadata",
    "body": [
      "---",
      "title: ${1:Title(タイトル)}",
      "description: ${2:Description(概要)}",
      "author: ${3:Author(著者)}",
      "date: ${4:${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}}",
      "tags: [${5:Tag1}, ${6:Tag2}]",
      "---",
    ],
    "description": "Markdown メタデータ(front matter)を挿入",
  },
  "[Markdown]テーブル": {
    "scope": "markdown",
    "prefix": "/table",
    "body": [
      "| ${1:Header} | ${2:Header} | ${3:Header} |",
      "| ${4|---,:--,:-:,--:|} | ${5|---,:--,:-:,--:|} | ${6|---,:--,:-:,--:|} |",
      "| ${7:item} | ${8:item} | ${9:item} |",
    ],
    "description": "Markdown テーブルを挿入",
  },

  "[Markdown]打ち消し線": {
    "scope": "markdown",
    "prefix": "/del",
    "body": ["~~${1:text}~~"],
    "description": "Markdown 打ち消し線を挿入",
  },
  "[Markdown]下付き文字": {
    "scope": "markdown",
    "prefix": "/sub",
    "body": ["<sub>${1:text}</sub>"],
    "description": "Markdown 下付き文字を挿入",
  },
  "[Markdown]上付き文字": {
    "scope": "markdown",
    "prefix": "/sup",
    "body": ["<sup>${1:text}</sup>"],
    "description": "Markdown 上付き文字を挿入",
  },
  "[Markdown]下線": {
    "scope": "markdown",
    "prefix": "/underline",
    "body": ["<u>${1:text}</u>"],
    "description": "Markdown 下線を挿入",
  },
  "[Markdown]ハイライト": {
    "scope": "markdown",
    "prefix": ["/mark", "/highlight"],
    "body": ["<mark>${1:text}</mark>"],
    "description": "Markdown ハイライトを挿入",
  },
  "[Markdown]カラーテキスト": {
    "scope": "markdown",
    "prefix": "/color",
    "body": [
      "<span style=\"color:${1|red,blue,green,orange,purple|}\">${2:text}</span>",
    ],
    "description": "Markdown カラーテキストを挿入",
  },
  "[Markdown]チェックボックス": {
    "scope": "markdown",
    "prefix": "/checkbox",
    "body": ["- [${1| ,x|}] ${2:item}"],
    "description": "Markdown チェックボックスを挿入",
  },
  "[Markdown]脚注参照": {
    "scope": "markdown",
    "prefix": "/reference",
    "body": ["[^${1:label}]"],
    "description": "Markdown 脚注参照を挿入",
  },
  "[Markdown]脚注本文": {
    "scope": "markdown",
    "prefix": "/foot",
    "body": ["[^${1:label}]: ${2:text}"],
    "description": "Markdown 脚注本文を挿入",
  },
  "[Markdown]日付": {
    "scope": "markdown",
    "prefix": "/date",
    "body": ["${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}"],
    "description": "Markdown 日付を挿入",
  },
  "[Markdown]アラート": {
    "scope": "markdown",
    "prefix": "/alert",
    "body": [
      "> ${1|[!NOTE],[!TIP],[!IMPORTANT],[!WARNING],[!CAUTION]|}",
      "> ${2:text}",
    ],
    "description": "Markdown アラートを挿入",
  },
  "[Markdown]折りたたみ": {
    "scope": "markdown",
    "prefix": ["/details", "/tree"],
    "body": [
      "${1|<details>,<details open>|}",
      "<summary>${2:Summary(要約)}</summary>",
      "",
      "${3:Content(内容)}",
      "",
      "</details>",
    ],
    "description": "Markdown 折りたたみを挿入",
  },

  "[Markdown]TODO": {
    "scope": "markdown",
    "prefix": "/todo",
    "body": [
      "## TODO",
      "",
      "- [ ] ${1:task}",
      "- [ ] ${2:task}",
      "- [ ] ${3:task}",
    ],
    "description": "Markdown TODOリストを挿入",
  },
  "[Markdown]メモ": {
    "scope": "markdown",
    "prefix": "/memo",
    "body": [
      "## Memo",
      "",
      "- Date: ${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}",
      "- Topic: ${1:topic}",
      "",
      "### Summary",
      "",
      "${2:summary}",
      "",
      "### Notes",
      "",
      "- ${3:note}",
    ],
    "description": "Markdown 技術メモテンプレートを挿入",
  },
  "[Markdown]意思決定ログ": {
    "scope": "markdown",
    "prefix": "/decision",
    "body": [
      "## Decision: ${1:title}",
      "",
      "- Date: ${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}",
      "- Status: ${2|Proposed,Accepted,Rejected,Deprecated|}",
      "- Owner: ${3:owner}",
      "",
      "### Context",
      "",
      "${4:背景・課題}",
      "",
      "### Decision",
      "",
      "${5:決定内容}",
      "",
      "### Rationale",
      "",
      "- ${6:理由}",
      "",
      "### Consequences",
      "",
      "- Positive: ${7:メリット}",
      "- Negative: ${8:デメリット・リスク}",
      "",
      "### Follow-up",
      "",
      "- [ ] ${9:次にやること}",
    ],
    "description": "Markdown 意思決定ログテンプレートを挿入",
  },
  "[Markdown]不具合メモ": {
    "scope": "markdown",
    "prefix": "/bug",
    "body": [
      "## Bug: ${1:title}",
      "",
      "- Date: ${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}",
      "- Severity: ${2|Low,Medium,High,Critical|}",
      "- Status: ${3|Open,Investigating,Fixed,Won't Fix|}",
      "",
      "### Summary",
      "",
      "${4:概要}",
      "",
      "### Environment",
      "",
      "- OS: ${5:OS}",
      "- Version: ${6:version}",
      "- Branch/Commit: ${7:branch or commit}",
      "",
      "### Steps to Reproduce",
      "",
      "1. ${8:step}",
      "2. ${9:step}",
      "3. ${10:step}",
      "",
      "### Expected",
      "",
      "${11:期待結果}",
      "",
      "### Actual",
      "",
      "${12:実際の結果}",
      "",
      "### Notes",
      "",
      "- ${13:調査メモ}",
    ],
    "description": "Markdown 不具合メモテンプレートを挿入",
  },
  "[Markdown]レビュー": {
    "scope": "markdown",
    "prefix": "/review",
    "body": [
      "## Review: ${1:title}",
      "",
      "- Date: ${CURRENT_YEAR}/${CURRENT_MONTH}/${CURRENT_DATE}",
      "- Target: ${2:PR / commit / document}",
      "- Reviewer: ${3:reviewer}",
      "",
      "### Summary",
      "",
      "${4:レビュー概要}",
      "",
      "### Good Points",
      "",
      "- ${5:良い点}",
      "",
      "### Concerns",
      "",
      "- ${6:懸念点}",
      "",
      "### Action Items",
      "",
      "- [ ] ${7:対応事項}",
      "",
      "### Result",
      "",
      "${8|Approved,Request changes,Comment only|}",
    ],
    "description": "Markdown レビューテンプレートを挿入",
  },

  "[Markdown]Mermaid汎用": {
    "scope": "markdown",
    "prefix": "/mm",
    "body": [
      "```mermaid",
      "${1|flowchart TD,flowchart LR,flowchart BT,flowchart RL,sequenceDiagram,classDiagram,stateDiagram-v2,erDiagram,journey,gantt,pie,quadrantChart,requirementDiagram,gitGraph,C4Context,mindmap,timeline,sankey,xychart,block,packet,kanban,architecture-beta|}",
      "    ${2:content}",
      "```",
    ],
    "description": "Markdown Mermaid汎用テンプレートを挿入",
  },
  "[Markdown]Mermaidフローチャート": {
    "scope": "markdown",
    "prefix": "/mm_flowchart",
    "body": [
      "```mermaid",
      "flowchart ${1|TD,LR,BT,RL|}",
      "    A[開始] --> B[処理]",
      "    B --> C{判定}",
      "    C -- Yes --> D[完了]",
      "    C -- No --> E[再確認]",
      "    E --> B",
      "```",
    ],
    "description": "Markdown Mermaid フローチャートを挿入",
  },
  "[Markdown]Mermaidシーケンス図": {
    "scope": "markdown",
    "prefix": "/mm_sequence",
    "body": [
      "```mermaid",
      "sequenceDiagram",
      "    participant User as User",
      "    participant App as App",
      "    participant API as API",
      "",
      "    User->>App: 操作",
      "    App->>API: リクエスト",
      "    API-->>App: レスポンス",
      "    App-->>User: 結果表示",
      "```",
    ],
    "description": "Markdown Mermaid シーケンス図を挿入",
  },
  "[Markdown]Mermaid状態遷移図": {
    "scope": "markdown",
    "prefix": "/mm_state",
    "body": [
      "```mermaid",
      "stateDiagram-v2",
      "    [*] --> Idle",
      "    Idle --> Running : start",
      "    Running --> Idle : stop",
      "    Running --> Error : error",
      "    Error --> Idle : reset",
      "```",
    ],
    "description": "Markdown Mermaid 状態遷移図を挿入",
  },
  "[Markdown]Mermaid ER図": {
    "scope": "markdown",
    "prefix": "/mm_er",
    "body": [
      "```mermaid",
      "erDiagram",
      "    USER ||--o{ ORDER : places",
      "    ORDER ||--|{ ORDER_ITEM : contains",
      "    PRODUCT ||--o{ ORDER_ITEM : included_in",
      "```",
    ],
    "description": "Markdown Mermaid ER図を挿入",
  },
  "[Markdown]Mermaidガントチャート": {
    "scope": "markdown",
    "prefix": "/mm_gantt",
    "body": [
      "```mermaid",
      "gantt",
      "    title ${1:Project Schedule}",
      "    dateFormat  YYYY-MM-DD",
      "",
      "    section Planning",
      "    要件整理 :a1, ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}, 7d",
      "    設計     :a2, after a1, 10d",
      "",
      "    section Development",
      "    実装     :a3, after a2, 15d",
      "    テスト   :a4, after a3, 5d",
      "```",
    ],
    "description": "Markdown Mermaid ガントチャートを挿入",
  },

  "[Markdown]ヘルプ": {
    "scope": "markdown",
    "prefix": "/help",
    "body": [
      "- [GitHub Docs Markdown](https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax)",
      "- [Markdown Guide](https://www.markdownguide.org/basic-syntax/)",
      "- [Mermaid Docs](https://mermaid.js.org/intro/)",
      "- [VS Code Snippets](https://code.visualstudio.com/docs/editing/userdefinedsnippets)",
    ],
    "description": "Markdown ヘルプリンクを挿入",
  },
}
